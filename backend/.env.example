# Webhook URL của máy quan sát (bỏ trống nếu không dùng)
WEBHOOK_URL=http://192.168.1.xxx:8080/notify

# Timeout chờ lệnh continue (ms), mặc định 10 phút
INSPECT_TIMEOUT_MS=600000

# API Key bảo mật (bỏ trống = không cần auth)
INTEGRATION_API_KEY=

# Tự động chạy vision_opencv.py cùng backend (chỉ để Live Feed cập nhật real-time,
# KHÔNG gửi detect — TMflow Pattern Matching vẫn là nguồn detect chính). Đặt =0 để tắt
# và tự chạy `python vision_opencv.py` tay (cần khi dùng cửa sổ debug để calibrate).
AUTO_START_VISION=1

# Lệnh Python dùng để chạy vision_opencv.py (đổi thành python3 nếu cần)
PYTHON_BIN=python
